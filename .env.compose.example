# Copy this file to the project-root .env and replace every placeholder.
# docker compose reads that file for interpolation; secrets are never copied
# into the Next.js or sidecar images. Do not commit the resulting .env.

# Authorized practice-target API (loopback/private endpoints recommended).
REVEL8_API_BASE=http://host.docker.internal:8000
REVEL8_TEAM_KEY=replace-with-your-practice-team-key

# OpenAI-compatible Writer endpoint. Planner falls back to this endpoint/key
# when the optional PLANNER_* values are left empty. Model IDs are selected in
# the UI; defaults remain kimi-k3.1 and abliterated-large-v2.
WRITER_BASE_URL=http://host.docker.internal:11434/v1
WRITER_API_KEY=replace-with-your-writer-key
PLANNER_BASE_URL=
PLANNER_API_KEY=

# Better Auth and the idempotent initial login seeded into local Convex.
# Use a freshly generated secret of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Separate random secret shared by Next.js and the local Convex service actions.
# It keeps long-running trace ingestion independent of expiring browser tokens.
REVEL8_INGEST_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-local-password
ADMIN_NAME=revel8 Admin

# Optional outbound OSINT/email integrations. Leave empty for local-only runs.
OSINT_BACKEND=firecrawl
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
RESEND_API_KEY=

# Browser-facing local URLs. Use http://localhost:3000 for the control room.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
NEXT_PUBLIC_REVEL8_SIDECAR=http://localhost:8787
