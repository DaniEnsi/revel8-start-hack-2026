{
	"name": "@x70-monorepo/database",
	"version": "0.0.0",
	"devDependencies": {
		"@better-auth/api-key": "1.6.14",
		"@better-auth/oauth-provider": "1.6.14",
		"@better-auth/passkey": "1.6.14",
		"@convex-dev/better-auth": "^0.12.4",
		"better-auth": "1.6.14",
		"convex": "^1.39.1",
		"resend": "^6.14.0",
		"typescript": "^5.8.3"
	},
	"scripts": {
		"db:generate": "node ../../scripts/db-generate.js",
		"db:generate:watch": "node ../../scripts/bootstrap-convex.js && convex dev",
		"dev:database": "docker compose -f ../../docker-compose.yml up convex",
		"dev:dashboard": "docker compose -f ../../docker-compose.yml up --no-deps convex-dashboard",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"exports": {
		".": "./src/index.ts",
		"./convex/*": "./convex/*"
	}
}
