# Host-based development only. The canonical one-command setup is the root
# ../.env.compose.example + `docker compose up` from the project root.
# Replace placeholders locally; never commit real credentials.

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211
NEXT_PUBLIC_REVEL8_SIDECAR=http://localhost:8787
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-a-generated-local-admin-key

SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
REVEL8_INGEST_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-unique-local-password
ADMIN_NAME=revel8 Admin
RESEND_API_KEY=

REVEL8_API_BASE=http://127.0.0.1:8000
REVEL8_TEAM_KEY=replace-with-your-practice-team-key
WRITER_BASE_URL=http://127.0.0.1:11434/v1
WRITER_API_KEY=replace-with-your-writer-key
PLANNER_BASE_URL=
PLANNER_API_KEY=
OSINT_BACKEND=firecrawl
FIRECRAWL_API_KEY=
