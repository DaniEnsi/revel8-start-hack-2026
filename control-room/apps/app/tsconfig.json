{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noImplicitAny": false,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./*"],
			"@x70-monorepo/database/convex/*": ["../../packages/database/convex/*"],
			"@x70-monorepo/database/*": ["../../packages/database/*"],
			"@x70-monorepo/*": ["../../packages/*/src"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		"apps/.next/types/**/*.ts",
		"next-env.d.ts",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
