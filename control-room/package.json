{
	"name": "x70-monorepo",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "node scripts/cleanup-ports.js && turbo run dev --filter=@x70-monorepo/app",
		"dev:stream": "node scripts/cleanup-ports.js && turbo run dev --ui=stream --filter=@x70-monorepo/app",
		"lint": "turbo run lint",
		"format": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"check-types": "turbo run check-types",
		"db:generate": "turbo run db:generate --filter=@x70-monorepo/database"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"prettier": "^3.5.3",
		"turbo": "^2.9.15",
		"typescript": "5.8.2"
	},
	"packageManager": "pnpm@10.8.0",
	"engines": {
		"node": ">=18"
	},
	"dependencies": {
		"@types/node": "^24.3.0",
		"zod": "^3.23.8"
	},
	"pnpm": {
		"overrides": {
			"@better-fetch/fetch": "1.1.21",
			"better-call": "1.3.5",
			"@better-auth/core": "1.6.14",
			"better-auth": "1.6.14",
			"react": "19.2.6",
			"react-dom": "19.2.6"
		}
	}
}
